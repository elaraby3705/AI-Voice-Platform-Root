import { useEffect, useState } from 'react';
import api from '../api/axios'; // Corrected Path
import { 
    User, Mail, Shield, Zap, Activity, CreditCard, 
    Lock, Smartphone, HardDrive, Key, Copy, Check,
    AlertTriangle, Download, Clock, Globe
} from 'lucide-react';

export default function Profile() {
    const [user, setUser] = useState(null);
    const [loading, setLoading] = useState(true);
    const [activeTab, setActiveTab] = useState('overview');
    const [copied, setCopied] = useState(false);

    useEffect(() => {
        const fetchUser = async () => {
            try {
                const response = await api.get('/auth/me/');
                setUser(response.data);
            } catch (err) {
                console.error("Error fetching profile", err);
            } finally {
                setLoading(false);
            }
        };
        fetchUser();
    }, []);

    const handleCopy = (text) => {
        navigator.clipboard.writeText(text);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    if (loading) return (
        <div className="min-h-screen bg-[#050505] flex items-center justify-center text-indigo-500 font-mono animate-pulse">
            <Activity className="w-6 h-6 animate-spin mr-3" /> Initializing Neural Profile...
        </div>
    );

    if (!user) return null;

    // Helper for Initials
    const getInitials = (name) => name ? name.substring(0, 2).toUpperCase() : 'OP';

    return (
        <div className="min-h-screen bg-[#050505] text-white p-8 ml-64 selection:bg-indigo-500/30">
            
            {/* --- Hero Header --- */}
            <div className="relative mb-10 rounded-3xl bg-[#0A0A0A] border border-white/10 p-8 overflow-hidden group">
                {/* Ambient Background */}
                <div className="absolute top-0 right-0 w-96 h-96 bg-indigo-600/10 blur-[100px] rounded-full pointer-events-none group-hover:bg-indigo-600/20 transition-all duration-700" />
                <div className="absolute bottom-0 left-0 w-64 h-64 bg-purple-600/5 blur-[80px] rounded-full pointer-events-none" />

                <div className="flex justify-between items-start relative z-10">
                    <div className="flex items-center gap-8">
                        <div className="w-28 h-28 rounded-2xl bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center text-4xl font-bold shadow-2xl ring-4 ring-black/50">
                            {getInitials(user.username || user.email)}
                        </div>
                        <div>
                            <div className="flex items-center gap-3 mb-2">
                                <h1 className="text-4xl font-bold tracking-tight text-white">{user.username || 'Unknown Operator'}</h1>
                                <span className="px-3 py-1 bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 rounded-full text-[10px] font-bold uppercase tracking-widest">
                                    {user.is_staff ? 'Admin' : 'Pro Plan'}
                                </span>
                            </div>
                            <div className="flex items-center gap-4 text-slate-400 text-sm font-mono">
                                <span className="flex items-center gap-2"><Mail className="w-4 h-4" /> {user.email}</span>
                                <span className="flex items-center gap-2 text-slate-500">|</span>
                                <span className="flex items-center gap-2 group-hover:text-white transition-colors cursor-pointer" onClick={() => handleCopy(user.id)}>
                                    <Shield className="w-4 h-4" /> 
                                    ID: <span className="font-mono">{user.id}</span>
                                    {copied ? <Check className="w-3 h-3 text-emerald-400" /> : <Copy className="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity" />}
                                </span>
                            </div>
                        </div>
                    </div>

                    <div className="text-right">
                        <div className="text-xs text-slate-500 font-bold uppercase tracking-widest mb-2">Current Balance</div>
                        <div className="text-3xl font-mono font-bold text-white mb-1">$2,450.00</div>
                        <div className="text-xs text-emerald-400 flex items-center justify-end gap-1">
                            <Zap className="w-3 h-3 fill-emerald-400" /> Auto-refill active
                        </div>
                    </div>
                </div>
            </div>

            {/* --- Tab Navigation --- */}
            <div className="flex gap-8 border-b border-white/10 mb-8 px-2">
                {['overview', 'security', 'billing', 'activity'].map((tab) => (
                    <button
                        key={tab}
                        onClick={() => setActiveTab(tab)}
                        className={`pb-4 text-sm font-bold transition-all capitalize relative ${
                            activeTab === tab 
                            ? 'text-white' 
                            : 'text-slate-500 hover:text-slate-300'
                        }`}
                    >
                        {tab}
                        {activeTab === tab && (
                            <span className="absolute bottom-0 left-0 w-full h-0.5 bg-indigo-500 shadow-[0_0_10px_rgba(99,102,241,0.5)]" />
                        )}
                    </button>
                ))}
            </div>

            {/* --- TAB CONTENT --- */}
            
            {/* 1. OVERVIEW TAB */}
            {activeTab === 'overview' && (
                <div className="grid grid-cols-12 gap-8 animate-in fade-in slide-in-from-bottom-4 duration-500">
                    
                    {/* Left: General Info */}
                    <div className="col-span-8 space-y-6">
                        <Section title="Personal Information" icon={User}>
                            <div className="grid grid-cols-2 gap-6">
                                <InputGroup label="Full Name" value={user.first_name ? `${user.first_name} ${user.last_name}` : ''} placeholder="Enter your full name" />
                                <InputGroup label="Display Name" value={user.username} readOnly />
                                <InputGroup label="Email Address" value={user.email} readOnly icon={Lock} />
                                <InputGroup label="Phone Number" value="+1 (555) 000-0000" placeholder="Add phone number" />
                            </div>
                            <div className="mt-6 flex justify-end">
                                <button className="px-6 py-2 bg-white text-black text-sm font-bold rounded-lg hover:bg-slate-200 transition-colors">
                                    Save Changes
                                </button>
                            </div>
                        </Section>

                        <Section title="API Configuration" icon={Key}>
                            <div className="flex items-center justify-between p-4 bg-black/30 rounded-xl border border-white/5 mb-4">
                                <div>
                                    <div className="text-xs text-slate-500 uppercase font-bold mb-1">Production Key</div>
                                    <div className="font-mono text-slate-300 text-sm">pk_live_51Msz...x92J</div>
                                </div>
                                <button className="p-2 hover:bg-white/10 rounded-lg text-slate-400 hover:text-white transition-colors">
                                    <Copy className="w-4 h-4" />
                                </button>
                            </div>
                            <div className="text-xs text-slate-500">
                                This key has full access to your project. Do not share it in client-side code.
                            </div>
                        </Section>
                    </div>

                    {/* Right: Usage Stats */}
                    <div className="col-span-4 space-y-6">
                        <div className="bg-[#0A0A0A] border border-white/10 rounded-2xl p-6">
                            <h3 className="text-sm font-bold text-slate-300 mb-6 flex items-center gap-2">
                                <HardDrive className="w-4 h-4" /> System Usage
                            </h3>
                            
                            <UsageBar label="Voice Generation" current={45} max={100} unit="hours" color="bg-indigo-500" />
                            <UsageBar label="Storage" current={7.2} max={10} unit="GB" color="bg-purple-500" />
                            <UsageBar label="Bandwidth" current={120} max={500} unit="GB" color="bg-emerald-500" />
                            
                            <div className="mt-6 pt-6 border-t border-white/5">
                                <button className="w-full py-2.5 bg-white/5 hover:bg-white/10 border border-white/10 text-white text-xs font-bold rounded-xl transition-all">
                                    Upgrade Quota
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            )}

            {/* 2. SECURITY TAB */}
            {activeTab === 'security' && (
                <div className="max-w-4xl space-y-6 animate-in fade-in slide-in-from-bottom-4 duration-500">
                    <Section title="Two-Factor Authentication" icon={Shield}>
                        <div className="flex items-center justify-between">
                            <div>
                                <p className="text-sm text-slate-300 mb-1">Add an extra layer of security to your account.</p>
                                <p className="text-xs text-slate-500">We recommend using an authenticator app like Authy or Google Authenticator.</p>
                            </div>
                            <button className="px-4 py-2 bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-bold rounded-lg hover:bg-emerald-500/20 transition-colors">
                                Enable 2FA
                            </button>
                        </div>
                    </Section>

                    <Section title="Active Sessions" icon={Smartphone}>
                        <div className="space-y-1">
                            <SessionRow device="Chrome on Windows" location="Cairo, Egypt" ip="156.202.xx.xx" active />
                            <SessionRow device="Safari on iPhone 14" location="Alexandria, Egypt" ip="197.34.xx.xx" lastActive="2 hours ago" />
                        </div>
                    </Section>

                    <div className="border border-rose-500/20 bg-rose-500/5 rounded-2xl p-6 mt-8">
                        <h3 className="text-rose-400 font-bold text-sm mb-2 flex items-center gap-2">
                            <AlertTriangle className="w-4 h-4" /> Danger Zone
                        </h3>
                        <p className="text-xs text-rose-300/70 mb-4">
                            Permanently delete your account and all of your content. This action is not reversible.
                        </p>
                        <button className="px-4 py-2 bg-rose-500 hover:bg-rose-600 text-white text-xs font-bold rounded-lg transition-colors">
                            Delete Account
                        </button>
                    </div>
                </div>
            )}

            {/* 3. BILLING TAB */}
            {activeTab === 'billing' && (
                <div className="grid grid-cols-12 gap-8 animate-in fade-in slide-in-from-bottom-4 duration-500">
                    <div className="col-span-7 space-y-6">
                        <div className="bg-gradient-to-br from-indigo-900/40 to-black border border-indigo-500/30 rounded-2xl p-6 relative overflow-hidden">
                            <div className="absolute top-0 right-0 p-6 opacity-20"><CreditCard className="w-32 h-32" /></div>
                            <div className="relative z-10">
                                <h3 className="text-sm font-bold text-indigo-300 uppercase tracking-widest mb-1">Active Plan</h3>
                                <h2 className="text-3xl font-bold text-white mb-4">Enterprise Tier</h2>
                                <ul className="space-y-2 mb-6">
                                    <li className="flex items-center gap-2 text-xs text-slate-300"><Check className="w-3 h-3 text-emerald-400" /> Unlimited Voice Generation</li>
                                    <li className="flex items-center gap-2 text-xs text-slate-300"><Check className="w-3 h-3 text-emerald-400" /> 4K Audio Quality</li>
                                    <li className="flex items-center gap-2 text-xs text-slate-300"><Check className="w-3 h-3 text-emerald-400" /> Priority Support</li>
                                </ul>
                                <button className="px-4 py-2 bg-white text-black text-xs font-bold rounded-lg hover:bg-slate-200">Manage Subscription</button>
                            </div>
                        </div>
                    </div>
                    <div className="col-span-5">
                        <Section title="Payment Method" icon={CreditCard}>
                            <div className="flex items-center gap-4 p-4 bg-white/5 rounded-xl border border-white/5">
                                <div className="w-12 h-8 bg-slate-700 rounded flex items-center justify-center text-xs font-bold">VISA</div>
                                <div>
                                    <div className="text-sm font-bold text-white">•••• 4242</div>
                                    <div className="text-xs text-slate-500">Expires 12/28</div>
                                </div>
                                <button className="ml-auto text-xs text-indigo-400 font-bold hover:text-white">Edit</button>
                            </div>
                        </Section>
                    </div>
                </div>
            )}
            
            {/* 4. ACTIVITY TAB (Placeholder) */}
            {activeTab === 'activity' && (
                 <div className="max-w-4xl space-y-4 animate-in fade-in slide-in-from-bottom-4 duration-500">
                     <Section title="Recent Activity Logs" icon={Clock}>
                         {[1,2,3].map((i) => (
                             <div key={i} className="flex items-center justify-between p-3 border-b border-white/5 last:border-0">
                                 <div className="flex items-center gap-3">
                                     <div className="w-2 h-2 rounded-full bg-indigo-500"></div>
                                     <span className="text-sm text-slate-300">Generated Voice Project "Campaign {i}"</span>
                                 </div>
                                 <span className="text-xs text-slate-600 font-mono">{i} hours ago</span>
                             </div>
                         ))}
                     </Section>
                 </div>
            )}

        </div>
    );
}

// --- SUB COMPONENTS (The Building Blocks) ---

const Section = ({ title, icon: Icon, children }) => (
    <div className="bg-[#0A0A0A] border border-white/10 rounded-2xl p-6 mb-6">
        <h3 className="text-sm font-bold text-slate-300 mb-6 flex items-center gap-2">
            {Icon && <Icon className="w-4 h-4 text-indigo-500" />} {title}
        </h3>
        {children}
    </div>
);

const InputGroup = ({ label, value, placeholder, readOnly, icon: Icon }) => (
    <div className="space-y-1.5">
        <label className="text-[10px] uppercase font-bold text-slate-500 tracking-wider ml-1">{label}</label>
        <div className="relative group">
            <input 
                type="text" 
                value={value || ''} 
                placeholder={placeholder}
                readOnly={readOnly}
                className={`w-full bg-[#111] border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-indigo-500/50 focus:ring-1 focus:ring-indigo-500/50 transition-all ${readOnly ? 'opacity-60 cursor-not-allowed' : ''}`}
            />
            {Icon && <Icon className="absolute right-3 top-3 w-4 h-4 text-slate-600" />}
        </div>
    </div>
);

const UsageBar = ({ label, current, max, unit, color }) => (
    <div className="mb-4 last:mb-0">
        <div className="flex justify-between mb-2">
            <span className="text-xs font-bold text-slate-400">{label}</span>
            <span className="text-xs font-mono text-slate-500">{current} / {max} {unit}</span>
        </div>
        <div className="w-full h-1.5 bg-white/5 rounded-full overflow-hidden">
            <div 
                className={`h-full ${color} rounded-full transition-all duration-1000`} 
                style={{ width: `${(current / max) * 100}%` }} 
            />
        </div>
    </div>
);

const SessionRow = ({ device, location, ip, active, lastActive }) => (
    <div className="flex items-center justify-between p-4 hover:bg-white/5 rounded-xl transition-colors border border-transparent hover:border-white/5">
        <div className="flex items-center gap-4">
            <div className={`p-2 rounded-lg ${active ? 'bg-indigo-500/20 text-indigo-400' : 'bg-slate-800 text-slate-400'}`}>
                {device.includes('iPhone') ? <Smartphone className="w-5 h-5" /> : <Globe className="w-5 h-5" />}
            </div>
            <div>
                <div className="text-sm font-bold text-white">{device}</div>
                <div className="text-xs text-slate-500 flex items-center gap-2">
                    {location} • <span className="font-mono">{ip}</span>
                </div>
            </div>
        </div>
        <div className="text-right">
            {active ? (
                <span className="px-2 py-1 bg-emerald-500/10 text-emerald-400 text-[10px] font-bold uppercase rounded border border-emerald-500/20">Active Now</span>
            ) : (
                <span className="text-xs text-slate-600 font-medium">{lastActive}</span>
            )}
        </div>
    </div>
);
